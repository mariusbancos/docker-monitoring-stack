# Copy to .env and adjust.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Interface the UIs listen on. Keep 127.0.0.1 and use an SSH tunnel or a
# reverse proxy with TLS; use 0.0.0.0 only behind a firewall.
BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000

PROMETHEUS_RETENTION=30d

# Optional exporters (only used when the matching profile is enabled)
MONGODB_URI=mongodb://monitor:password@db.example.internal:27017/admin
REDIS_ADDR=redis://cache.example.internal:6379
REDIS_PASSWORD=
POSTGRES_DSN=postgresql://monitor:password@pg.example.internal:5432/postgres?sslmode=require
